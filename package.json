    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
